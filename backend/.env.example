PORT=5000
NODE_ENV=development
# Must match the origin the frontend is actually served from, or the browser
# blocks every API call on CORS before it reaches the server.
CLIENT_URL=http://localhost:5174
MONGO_URI=mongodb://localhost:27017/Fursad_Platform
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10

# --- Secrets -----------------------------------------------------------------
# Leave these EMPTY here. This file is committed, so any value written below is
# public, and the server refuses to start on a public secret.
#
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# JWT_SECRET signs every session token. Anyone who knows it can mint a token for
# any account, including an administrator. Changing it signs everyone out.
JWT_SECRET=
# ADMIN_SECRET is the only thing standing between a stranger and an admin
# account, because /api/auth/register accepts role=admin when it matches.
ADMIN_SECRET=

# --- Google Gemini (AI Studio) ---
# Paste your key here. Everything AI-powered stays in mock mode until it is set.
GEMINI_API_KEY=
# Model ids are overridable so they can be bumped without a code change.
# Check Google AI Studio for the current Flash id.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# --- Email (SMTP) ---
# Without these the app still runs; verification and reset codes are logged to
# the server console instead of being delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
MANAGEMENT_EMAIL=
