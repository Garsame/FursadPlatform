# ============================================================================
#  Fursad — production environment
#  Copy to  fursad/backend/.env  on the server and fill in every value.
#  This file is a TEMPLATE and is safe to commit. The real .env is gitignored
#  and must never be committed — it holds live keys.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
PORT=5000
NODE_ENV=production

# The EXACT origin the browser will load the site from. Scheme included, no
# trailing slash. If this and the address in the URL bar disagree, the browser
# discards every API response and the site loads but does nothing.
CLIENT_URL=https://yourdomain.com

# --- Database ---------------------------------------------------------------
# MongoDB runs on this same machine and is bound to loopback only. Port 27017
# is never opened in the firewall.
MONGO_URI=mongodb://127.0.0.1:27017/Fursad_Platform

# --- Sessions ---------------------------------------------------------------
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10

# --- Secrets — GENERATE THESE ON THE SERVER --------------------------------
# The server validates both at boot: required, 32+ characters, and never one
# of the two values that were once published in .env.example. It calls
# process.exit(1) rather than starting on a weak secret.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # ADMIN_SECRET
#
# Changing JWT_SECRET signs everyone out. Passwords are unaffected.
JWT_SECRET=
ADMIN_SECRET=

# --- Google Gemini ----------------------------------------------------------
# Without a key the platform still runs: every AI function falls back to
# realistic canned output and no user is blocked.
GEMINI_API_KEY=

# Set these explicitly. The code's built-in fallbacks are OLDER models
# (gemini-2.0-flash / text-embedding-004) that the platform was not tuned
# against — leaving these blank silently changes your matching behaviour.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# --- Email (SMTP) -----------------------------------------------------------
# Without these the app runs and prints verification and reset codes to the
# PM2 log instead of sending them. Gmail app-password spaces are stripped for
# you, so paste it however it is displayed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
MANAGEMENT_EMAIL=

# --- Behind Nginx — REQUIRED -----------------------------------------------
# Rate limiting counts per client address. Nginx is one proxy hop in front of
# the API, so without this every visitor collapses into a single bucket: ten
# failed logins from anyone locks out everyone. Set to the number of proxies
# (1 for this setup). It is a hop count rather than blind trust, because
# trusting blindly lets a client forge X-Forwarded-For and dodge the limits.
TRUST_PROXY=1

# ============================================================================
#  Optional — every one of these has a working default in code.
#  Leave them out unless you have a reason.
# ============================================================================

# Outbound emails allowed per 10 minutes, per address. Default 8.
# RATE_LIMIT_EMAIL=8

# Profile completeness required before a candidate may apply. Default 70.
# MIN_PROFILE_COMPLETENESS=70

# Score at or above which a new vacancy notifies a candidate. Default 70.
# NOTIFY_MATCH_THRESHOLD=70

# Floor below which a new employer is not announced to a candidate. Default 50.
# NOTIFY_RELEVANCE_FLOOR=50

# Semantic skill-matching calibration band. Raw embedding similarity between
# two unrelated short technical terms sits around 0.68, so the floor is what
# stops noise earning credit. Defaults 0.62 / 0.86.
# Raising the floor tightens matching and lowers every score — changing it
# invalidates comparisons against previously stored application scores.
# SKILL_SIM_FLOOR=0.62
# SKILL_SIM_CEIL=0.86
