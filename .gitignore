# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Build outputs
dist/
build/
out/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.system_generated/

# Uploaded user content.
# CVs and profile photos are other people's personal data — real names, dates
# of birth, phone numbers, addresses. They must never reach the repository,
# and this repository has a public remote. The seeded company wordmarks are
# project assets rather than uploads, so they are the one exception.
backend/uploads/cvs/*
!backend/uploads/cvs/.gitkeep
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
!backend/uploads/avatars/logo-*.svg
